<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>Uploadrr_Unraid</Name>
  <Repository>ghcr.io/wildfirebill-arrrs/uploadrr_unraid:latest</Repository>
  <Registry>https://ghcr.io/wildfirebill-arrrs/uploadrr_unraid</Registry>
  <Network>bridge</Network>
  <MyIP></MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/wildfirebill-arrrs/uploadrr/issues</Support>
  <Project>https://github.com/wildfirebill-arrrs/uploadrr_unraid</Project>
  <Overview>Uploadrr prepares and uploads torrents for Movies, TV, Music, and Adult content to 50+ private trackers. CLI tool - exec into the container to run commands.</Overview>
  <Description>Uploadrr automates metadata gathering, screenshot generation, torrent creation, and uploading to private trackers. This container stays running (tail) so you can exec into it via the Unraid console or docker exec and run: python3 /app/upload.py /data/path/to/media --trackers BLU HDB. Configure /app/data/config.yaml first.</Description>
  <Category>Tools:Utilities</Category>
  <WebUI></WebUI>
  <TemplateURL>https://raw.githubusercontent.com/wildfirebill-unraid/unraid-configs/main/templates/uploadrr.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/wildfirebill-unraid/unraid-configs/main/icon.svg</Icon>
  <ExtraParams>--entrypoint tail</ExtraParams>
  <PostArgs>-f /dev/null</PostArgs>
  <ExtraSearchTerms>uploadrr torrent uploader private tracker</ExtraSearchTerms>
  <Requires>Configure /app/data/config.yaml before use.</Requires>
  <Changes>Initial release</Changes>
  <MinVer>6.10</MinVer>
  <MaxVer></MaxVer>
  <License>MIT</License>

  <Config Name="Config (data)" Target="/app/data" Default="/mnt/user/appdata/uploadrr/data" Mode="rw" Description="Persistent config (config.yaml) and metadata." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/uploadrr/data</Config>
  <Config Name="Temp" Target="/app/tmp" Default="/mnt/user/appdata/uploadrr/tmp" Mode="rw" Description="Temporary/working files." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/uploadrr/tmp</Config>
  <Config Name="Media" Target="/data" Default="/mnt/user/data/torrents" Mode="rw" Description="Media to upload (map to your download client's path)." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/data/torrents</Config>
  <Config Name="Torrent Storage" Target="/torrent_storage_dir" Default="/mnt/user/appdata/qbittorrent/data/BT_backup" Mode="rw" Description="Client BT_backup for torrent reuse (optional)." Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/qbittorrent/data/BT_backup</Config>
  <Config Name="PUID" Target="PUID" Default="99" Description="User ID to run as (Unraid nobody=99)." Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Description="Group ID to run as (Unraid users=100)." Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Description="Timezone." Type="Variable" Display="advanced" Required="false" Mask="false">America/New_York</Config>
</Container>