<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>ExampleApp</Name>
  <Repository>your-dockerhub/example-app:latest</Repository>
  <Registry>https://hub.docker.com</Registry>
  <Network>bridge</Network>
  <MyIP></MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/wildfirebill-unraid/unraid-configs</Support>
  <Project>https://github.com/your-repo/example-app</Project>
  <Overview>Example Docker application template for Unraid.</Overview>
